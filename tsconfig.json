{
  "//": "Prüft den Programmcode mit TypeScript (Tippfehler, unbekannte Namen, falsche Aufrufe). Es wird nichts erzeugt. Aufruf: npx tsc -p tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": [
    "quelle/js/*.js",
    "quelle/typen.d.ts"
  ]
}
